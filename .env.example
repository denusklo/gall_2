APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gallery
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CORS_ALLOWED_ORIGINS=http://localhost

# Comma-separated hosts for cookie-based SPA auth. In production set to the Vercel domain (e.g. your-app.vercel.app).
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Sanctum token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200
# Keep true in production (HTTPS only); set false only for plain-http local dev
SESSION_SECURE_COOKIE=true

# Debugbar (dev only; never enable in production)
DEBUGBAR_ENABLED=false

# Supabase storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob
VERCEL_BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_STORE_URL=

# Firebase (server). Credentials: path to service-account JSON (kept out of git) or the JSON itself
FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_DEFAULT_BUCKET=
FIREBASE_AUTH_TENANT_ID=

# Firebase (web / FCM client config served at /fcm-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
# FIREBASE_WEB_API_KEY= (optional override of FIREBASE_API_KEY; leave unset rather than empty)

# Storage maintenance cron. Generate with: openssl rand -hex 32 (min 16 chars).
# If unset, /apiv/_1/internal/storage-maintenance always returns 401 and maintenance never runs.
CRON_SECRET=
STORAGE_NAMESPACE=
