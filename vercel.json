{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "memory": 1024
        }
    },
    "routes": [
        {
            "src": "/firebase-messaging-sw.js",
            "dest": "/public/firebase-messaging-sw.js",
            "headers": {
                "Content-Type": "application/javascript",
                "Service-Worker-Allowed": "/",
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/manifest\\.webmanifest",
            "dest": "/public/manifest.webmanifest",
            "headers": {
                "Content-Type": "application/manifest+json",
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/icons/(.*)\\.png",
            "dest": "/public/icons/$1.png",
            "headers": {
                "Content-Type": "image/png",
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/fcm-config\\.js",
            "dest": "/api/index.php",
            "headers": {
                "Content-Type": "application/javascript",
                "Cache-Control": "no-cache, max-age=0, must-revalidate",
                "CDN-Cache-Control": "no-store",
                "Vercel-CDN-Cache-Control": "no-store"
            }
        },
        {
            "src": "/(css|js|images)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/favicon\\.(ico|svg)",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Gall-2",
        "APP_DEBUG": "false",
        "APP_URL": "https://gall-2.vercel.app/",
        "FIREBASE_DATABASE_URL": "https://usforus-3e70b-default-rtdb.asia-southeast1.firebasedatabase.app/",
        "CACHE_PATH": "/tmp/cache",
        "SESSIONS_PATH": "/tmp/sessions",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr",
        "SESSION_SECURE_COOKIE": "true"
    },
    "crons": [
        {
            "path": "/apiv/_1/internal/storage-maintenance",
            "schedule": "0 16 * * *"
        }
    ],
    "buildCommand": "npm run build"
}